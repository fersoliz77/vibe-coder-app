{
  "name": "vibe-ide-coder",
  "version": "1.0.0",
  "description": "Vibe IDE Code - IDE para Vibecoding con IA",
  "author": "Vibe IDE Code",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run test && npm run build",
    "build": "vite build",
    "package": "node scripts/generate-auth-config.js && vite build && electron-builder",
    "package:dir": "node scripts/generate-auth-config.js && vite build && electron-builder --dir",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:validate": "node scripts/validate-release-manifest.js",
    "release:verify-installer": "node scripts/verify-windows-installer.js",
    "release:smoke": "node scripts/release-smoke.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@napi-rs/keyring": "^1.3.0",
    "@openai/codex": "^0.144.3",
    "@supabase/supabase-js": "^2.110.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^15.0.0",
    "node-pty": "^1.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supabase": "^2.109.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.0",
    "playwright": "^1.61.1",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.vibeidecoder.app",
    "productName": "Vibe IDE Code",
    "protocols": [
      {
        "name": "Vibe IDE Code Authentication",
        "schemes": ["vibeidecode"]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex*/**/*",
      "node_modules/supabase*/**/*",
      "node_modules/@supabase/cli-windows-*/**/*",
      "node_modules/@napi-rs/keyring*/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
