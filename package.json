{
  "name": "vibe-ide-coder",
  "version": "1.1.11",
  "description": "Vibe IDE Code - IDE para Vibecoding con IA",
  "author": "Vibe IDE Code",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run test && npm run check:tokens && npm run check:tokens-sync && npm run check:fonts && npm run check:legacy && npm run check:breakpoints && npm run check:literals && npm run check:a11y && npm run check:contrast && npm run check:design && npm run build && npm run check:bundle",
    "tokens": "node design-tokens/build.mjs",
    "check:tokens-sync": "node design-tokens/build.mjs --check",
    "check:fonts": "node scripts/check_font_loading.mjs",
    "check:legacy": "node scripts/check_legacy_tokens.mjs",
    "check:breakpoints": "node scripts/check_breakpoints.mjs",
    "check:literals": "node scripts/check_literals.mjs",
    "check:tokens": "node scripts/check_token_refs.mjs",
    "check:a11y": "node scripts/check_static_a11y.mjs",
    "check:contrast": "node scripts/check_contrast.mjs",
    "check:design": "node scripts/check_design_system.mjs",
    "check:bundle": "node scripts/check_bundle_budgets.mjs",
    "build": "vite build",
    "package": "node scripts/generate-auth-config.js && vite build && electron-builder",
    "package:dir": "node scripts/generate-auth-config.js && vite build && electron-builder --dir",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:validate": "node scripts/validate-release-manifest.js",
    "release:verify-installer": "node scripts/verify-windows-installer.js",
    "release:smoke": "node scripts/release-smoke.js",
    "release:sign-update": "node scripts/sign-update-metadata.js",
    "release:publish": "node scripts/publish-github-release.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@napi-rs/keyring": "^1.3.0",
    "@openai/codex": "^0.144.3",
    "@supabase/supabase-js": "^2.110.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "6.8.9",
    "marked": "^15.0.0",
    "node-pty": "^1.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supabase": "^2.109.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "vite": "^6.3.0",
    "wait-on": "^9.1.0",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "com.vibeidecoder.app",
    "productName": "Vibe IDE Code",
    "protocols": [
      {
        "name": "Vibe IDE Code Authentication",
        "schemes": [
          "vibeidecode"
        ]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@openai/codex*/**/*",
      "node_modules/supabase*/**/*",
      "node_modules/@supabase/cli-windows-*/**/*",
      "node_modules/@napi-rs/keyring*/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/stable"
      }
    ],
    "nsis": {
      "artifactName": "Vibe-IDE-Code-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
