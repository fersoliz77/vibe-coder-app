# Read by Electron main at runtime. Do not use VITE_ prefixes: credentials must not enter the renderer bundle.
VIBE_SUPABASE_URL=https://your-project.supabase.co
VIBE_SUPABASE_ANON_KEY=your-public-anon-key
# Legacy name retained only for technical compatibility; selects the account access RPC.
VIBE_SUPABASE_MEMBERSHIP_RPC=get_desktop_access
VIBE_AUTH_HELP_URL=https://platform.example/help
# Private Supabase Storage location. Only active desktop entitlements can read it.
VIBE_UPDATE_BUCKET=desktop-releases
VIBE_UPDATE_CHANNEL=stable
